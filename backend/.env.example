NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=cybersuraksha

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cybersuraksha-api
JWT_AUDIENCE=cybersuraksha-client

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SECRET=replace_with_a_secure_otp_hmac_secret

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cybersuraksha.local

FRONTEND_ORIGIN=http://localhost:5173

# Optional initial admin bootstrap credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@cybersuraksha.org
ADMIN_PASSWORD=Admin@Secure2026!

